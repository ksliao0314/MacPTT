{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacPTT",
  "version": "1.2.1",
  "identifier": "cc.ptt.pttchrome-v3",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MacPTT",
        "width": 880,
        "height": 530,
        "minWidth": 880,
        "minHeight": 530,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ksliao0314/MacPTT/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCQUIyRTBENjE0NUFBRTcKUldUbnFrVmhEUzZyNnl2VWZ1WVZoNkI2TUY2a0U4dFFhOVUxdmJCb0cySmFCSHNZczF6R0FWMm8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.social-networking",
    "copyright": "© 2026 MacPTT",
    "shortDescription": "Native macOS PTT BBS client",
    "longDescription": "MacPTT is a native macOS client for the PTT BBS, with a terminal-style interface, image and link previews, a blacklist, and saved local auto-login.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
